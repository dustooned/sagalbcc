# Copy to .env (never commit .env). The server refuses to start without a password.

# Shared table password. Checked on the server only; never shipped to the browser.
TABLE_PASSWORD=change-me

# Server port (HTTP API + websockets).
PORT=2568

# Optional: pin the token-signing secret so player sessions survive a server restart.
# SESSION_SECRET=a-long-random-string
# SESSION_HOURS=12

# Uploaded piece images (relative to the table folder). Local disk for now.
# UPLOAD_DIR=.data/uploads
# MAX_UPLOAD_MB=8
# Largest single websocket message: a kit load can carry several rasterized images (default 6).
# MAX_MESSAGE_MB=6

# Minutes a table with nobody connected stays open so players can come back (default 30).
# EMPTY_TABLE_MINUTES=30
# Behind a hosting proxy (Render, Fly, Railway, nginx…): number of proxy hops, so rate limits
# see each player's own IP instead of the proxy's.
# TRUST_PROXY=1

# ---- Client (Vite reads VITE_* at build/dev time) ----
# Where the browser finds the server. Leave unset in production when the server also serves the client.
VITE_SERVER_URL=http://localhost:2568
